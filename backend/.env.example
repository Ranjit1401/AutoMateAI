# Copy this file to .env and fill in real values.

# --- App ---
ENVIRONMENT=development
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database (SQLite works with zero setup; swap for Postgres in prod) ---
DATABASE_URL=sqlite:///./automateai.db

# --- Auth ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false

# --- LLM (required for chat) ---
GROQ_API_KEY=
MODEL_NAME=llama-3.3-70b-versatile

# --- Tool providers ---
OPENWEATHER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY = bcb0f4c2bfde4b22433053094dc486b3

# --- Google OAuth (Gmail / Calendar / Drive / Sheets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/oauth/callback

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# --- Vapi ---
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# --- n8n (optional automation webhook) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
